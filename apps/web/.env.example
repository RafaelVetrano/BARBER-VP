# apps/web — copie para `.env.local` ao rodar fora do docker.
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
PORT=3000

# Endereço da API visto do SERVIDOR do Next (render das rotas indexadas).
# Fora do docker é o mesmo do navegador; dentro do compose, `http://api:3333/api/v1`.
# API_INTERNAL_URL=http://localhost:3333/api/v1

# ── Produção: um deploy, quatro hosts ────────────────────────────────────────
# Sem estas variáveis o app roda em "prefixo direto" (o modo de desenvolvimento):
# `/` landing · `/agendar` + `/{slug}` booking · `/app/*` painel · `/admin/*` admin.
#
# Definidas, o middleware resolve cada host para o seu prefixo e `/admin/*` passa
# a responder SÓ no host do admin (404 nos demais).
# HOST_SITE=barbervp.com
# HOST_BOOKING=agendar.barbervp.com
# HOST_APP=app.barbervp.com
# HOST_ADMIN=admin.barbervp.com
#
# Origem de cada superfície, para os links que saem de uma para outra e para o
# canonical do SEO. Vazias = links relativos, o visitante fica no host atual.
# NEXT_PUBLIC_SITE_URL=https://barbervp.com
# NEXT_PUBLIC_BOOKING_URL=https://agendar.barbervp.com
# NEXT_PUBLIC_DASHBOARD_URL=https://app.barbervp.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.barbervp.com
