{
  "name": "@barbervp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "clean": "rm -rf dist node_modules/.cache",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand --passWithNoTests",
    "test:isolation": "jest --config test/jest-isolation.json --runInBand --passWithNoTests"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@barbervp/types": "workspace:*",
    "@nest-lab/throttler-storage-redis": "1.1.0",
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.6",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.6",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.6",
    "@nestjs/swagger": "8.0.1",
    "@nestjs/throttler": "6.2.1",
    "@node-rs/argon2": "1.8.3",
    "@prisma/client": "5.22.0",
    "bullmq": "5.34.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "nestjs-pino": "4.1.0",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@barbervp/config": "workspace:*",
    "@nestjs/cli": "10.4.5",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "22.8.6",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.12.2",
    "@typescript-eslint/parser": "8.12.2",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "pino-pretty": "11.3.0",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3"
  }
}
