# apps/api — copie para `.env` ao rodar a API fora do docker.
# No `make up` estas variáveis vêm do `.env` da raiz via docker-compose.

NODE_ENV=development
API_PORT=3333
API_PREFIX=api/v1
LOG_LEVEL=debug

DATABASE_URL=postgresql://barbervp:barbervp_dev_pwd@localhost:5432/barbervp?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

THROTTLE_TTL=60
THROTTLE_LIMIT=120

CORS_ORIGIN_SITE=http://localhost:3000
CORS_ORIGIN_BOOKING=http://localhost:3001
CORS_ORIGIN_DASHBOARD=http://localhost:3002
CORS_ORIGIN_ADMIN=http://localhost:3003

NOTIFICATION_DRIVER=mock
PAYMENT_DRIVER=mock
MAIL_DRIVER=mock
