# Imagem única de desenvolvimento, compartilhada por api e web.
# O código vem por bind mount (ver docker-compose.yml); a imagem carrega só as
# dependências instaladas e os artefatos que precisam de build (Prisma Client,
# `@barbervp/types`).
FROM node:22-bookworm-slim

# `openssl` é exigido pelo engine do Prisma.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app
RUN chown node:node /app

# Tudo daqui para baixo roda como `node`, que na imagem oficial é uid/gid
# 1000 — o mesmo do dono do checkout no host.
#
# Sem isto, o container escreve como root ATRAVÉS do bind mount, e artefatos
# de build (`packages/types/dist` no boot da api, por exemplo) nascem
# root-owned no host: o `pnpm build` do desenvolvedor então falha com EACCES
# em arquivos que ele mesmo acabou de mandar gerar. Era a dívida da fase 02.
USER node

# Camada de dependências — só invalida quando um manifesto muda.
COPY --chown=node:node pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY --chown=node:node packages/config/package.json packages/config/
COPY --chown=node:node packages/types/package.json packages/types/
COPY --chown=node:node packages/ui/package.json packages/ui/
COPY --chown=node:node apps/api/package.json apps/api/
COPY --chown=node:node apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile

COPY --chown=node:node . .

# `@barbervp/types` é consumido compilado (CJS); o Prisma Client precisa existir
# antes do primeiro `nest start`.
RUN pnpm --filter @barbervp/types build \
  && pnpm --filter @barbervp/api exec prisma generate

# Os diretórios de saída precisam EXISTIR na imagem. Um volume anônimo cujo
# caminho não existe na imagem nasce pertencendo a root, e o processo (agora
# `node`) não conseguiria escrever nele.
RUN mkdir -p apps/web/.next

ENV NODE_ENV=development
