# Imagem única de desenvolvimento, compartilhada por api e pelas 4 webs.
# O código vem por bind mount (ver docker-compose.yml); a imagem carrega só as
# dependências instaladas e os artefatos que precisam de build (Prisma Client,
# `@barbervp/types`).
FROM node:22-bookworm-slim

# `openssl` é exigido pelo engine do Prisma.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

# Camada de dependências — só invalida quando um manifesto muda.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY packages/config/package.json packages/config/
COPY packages/types/package.json packages/types/
COPY packages/ui/package.json packages/ui/
COPY apps/api/package.json apps/api/
COPY apps/site/package.json apps/site/
COPY apps/booking/package.json apps/booking/
COPY apps/dashboard/package.json apps/dashboard/
COPY apps/admin/package.json apps/admin/
RUN pnpm install --frozen-lockfile

COPY . .

# `@barbervp/types` é consumido compilado (CJS); o Prisma Client precisa existir
# antes do primeiro `nest start`.
RUN pnpm --filter @barbervp/types build \
  && pnpm --filter @barbervp/api exec prisma generate

ENV NODE_ENV=development
