# ─────────────────────────────────────────────────────────────
# BarberVP — variáveis de ambiente (raiz do monorepo)
# Copie para `.env` (`make env`) e ajuste. NUNCA commitar `.env`.
# O docker-compose lê este arquivo; os apps também têm `.env.example` próprio.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=barbervp
POSTGRES_PASSWORD=barbervp_dev_pwd
POSTGRES_DB=barbervp
POSTGRES_PORT=5432
# Host (fora do docker) usa localhost; dentro do compose o host é `db`.
DATABASE_URL=postgresql://barbervp:barbervp_dev_pwd@localhost:5432/barbervp?schema=public

# ── Redis ───────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── API ─────────────────────────────────────────────────────
API_PORT=3333
API_PREFIX=api/v1
LOG_LEVEL=debug

# JWT — trocar por segredos fortes em produção (>= 32 chars)
JWT_ACCESS_SECRET=dev_access_secret_change_me_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Rate limit global (auth/OTP têm limites próprios, bem mais agressivos)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ── Auth (fase 03) ──────────────────────────────────────────
# Domínio do cookie httpOnly de refresh. Vazio = host-only (dev, cada app numa
# porta de localhost). Em produção: .seudominio.com.br
AUTH_COOKIE_DOMAIN=

# OTP de 6 dígitos do cliente — o cooldown de 59s é o do protótipo.
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=59
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=4
OTP_MAX_PER_DESTINATION_HOUR=6

# Link de recuperação de senha do estabelecimento (MailOutbox mock)
PASSWORD_RESET_TTL_MINUTES=30

# ── Booking público (fase 04) ───────────────────────────────
# Calibração pedida pelo SPEC. A defesa de verdade contra agenda lotada de
# graça é o OTP condicional do guest booking, que olha telefone e
# comportamento; o teto por IP é frouxo de propósito, porque operadora de
# celular e wi-fi público põem milhares de pessoas atrás do mesmo endereço.

# Reservas que um IP pode abrir por hora (429 acima disso)
BOOKING_CREATE_HOURLY_LIMIT=30
# Reservas de visitante por IP/hora antes de passar a exigir código
BOOKING_GUEST_IP_HOURLY_LIMIT=6
# Horários futuros em aberto por telefone antes de exigir código
BOOKING_GUEST_OPEN_LIMIT=2

# ── Porta do frontend ───────────────────────────────────────
# Frontend único desde a fase 11: as quatro superfícies são prefixos de rota do
# mesmo app (`/` landing · `/agendar` e `/{slug}` booking · `/app` painel ·
# `/admin` super admin).
WEB_PORT=3000

# ── CORS — uma origem explícita por superfície (sem wildcard) ─
# Em dev as quatro apontam para a mesma origem; em produção, para os quatro
# hosts reais. A API valida as quatro variáveis, então todas continuam aqui.
CORS_ORIGIN_SITE=http://localhost:3000
CORS_ORIGIN_BOOKING=http://localhost:3000
CORS_ORIGIN_DASHBOARD=http://localhost:3000
CORS_ORIGIN_ADMIN=http://localhost:3000

# Base do link público de agendamento.
# Sem valor, cai em CORS_ORIGIN_BOOKING.
PUBLIC_BOOKING_BASE_URL=http://localhost:3000

# ── Frontend → API ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
# Endereço da API visto do SERVIDOR do Next (render das rotas indexadas). Dentro
# do compose é `http://api:3333/api/v1` — é o padrão do docker-compose.yml, não
# defina aqui a menos que rode o Next fora do docker.
# API_INTERNAL_URL=http://localhost:3333/api/v1

# ── Produção: um deploy, quatro hosts ───────────────────────
# Só em produção. Definidas, o middleware do `apps/web` resolve cada host para o
# seu prefixo e `/admin/*` passa a responder SÓ no host do admin (404 nos
# demais). Sem elas, o app roda em prefixo direto — o modo de desenvolvimento.
# HOST_SITE=barbervp.com
# HOST_BOOKING=agendar.barbervp.com
# HOST_APP=app.barbervp.com
# HOST_ADMIN=admin.barbervp.com
#
# Origem de cada superfície, para os links que saem de uma para outra e para o
# canonical do SEO. Vazias = links relativos, o visitante fica no host atual.
# NEXT_PUBLIC_SITE_URL=https://barbervp.com
# NEXT_PUBLIC_BOOKING_URL=https://agendar.barbervp.com
# NEXT_PUBLIC_DASHBOARD_URL=https://app.barbervp.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.barbervp.com

# ── Adapters (fase 01: apenas drivers mock) ─────────────────
NOTIFICATION_DRIVER=mock
PAYMENT_DRIVER=mock
MAIL_DRIVER=mock
AI_ASSISTANT_DRIVER=mock
BILLING_MAX_FAILED_ATTEMPTS=3

# ── Filas BullMQ (fase 09) ──────────────────────────────────
# Liga os WORKERS neste processo. A API enfileira e o painel de jobs lê a fila
# de qualquer jeito — desligar aqui é o que permite separar réplica de web de
# réplica de worker usando a MESMA imagem.
QUEUE_WORKERS_ENABLED=true
# Intervalo da varredura do outbox (lembretes de agendamento saem por aqui).
QUEUE_OUTBOX_INTERVAL_SECONDS=60
# Hora local dos jobs diários. Escalonados para não competirem pelo banco.
QUEUE_SUBSCRIPTION_RENEWAL_HOUR=3
QUEUE_SAAS_BILLING_HOUR=4
QUEUE_MAINTENANCE_HOUR=5
QUEUE_TIMEZONE=America/Sao_Paulo
